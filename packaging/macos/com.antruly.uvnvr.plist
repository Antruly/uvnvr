<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.antruly.uvnvr</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/uvnvr/bin/uvnvr</string>
    <string>--port</string><string>8080</string>
    <string>--rtsp-port</string><string>554</string>
    <string>--data-dir</string><string>/Library/Application Support/UvNVR</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/uvnvr.log</string>
  <key>StandardErrorPath</key><string>/var/log/uvnvr.log</string>
</dict>
</plist>
